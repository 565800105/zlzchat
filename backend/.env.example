# ===== 应用配置 =====
APP_NAME=ZLZCHAT 公众号信息管理系统
# JWT 签名密钥，生产环境务必修改为随机长字符串
SECRET_KEY=zlzchat-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 =====
# 默认 SQLite（零配置，开箱即用）；如需 MySQL 改为：
#mysql+pymysql://root:123456@localhost:3308/zlzchatpython?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:123456@localhost:3308/zlzchatpython?charset=utf8mb4

# ===== 数据目录（图片资源 / SQLite 库 / 迁移图片目标）=====
# 默认 backend/data。Docker 部署时设为挂载卷路径，如 /app/data，宿主机挂载即可持久化
#DATA_DIR=/app/data

# ===== 微信读书外部服务（skey 刷新 / 正文下载）=====
# 与 Java 版 application.yml 中 jdsoft.apiServerUrl 一致
API_SERVER_URL=http://111.229.83.152

# ===== 服务监听 =====
HOST=0.0.0.0
PORT=8100
